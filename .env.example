# Copie para .env e ajuste.
DATABASE_URL=postgresql://lei:troque-esta-senha@localhost:5432/lei

# Opcional. Com a chave, o Claude escreve a resposta a partir dos artigos; sem ela, modo extrativo.
ANTHROPIC_API_KEY=
MODELO_LLM=claude-opus-5-5

# Modelo de embedding (roda localmente). Ver a comparação no README.
MODELO_EMBEDDING=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Só para os testes: banco descartável, apagado a cada execução.
TEST_DATABASE_URL=postgresql://lei:troque-esta-senha@localhost:5432/lei_teste
